# MySQL connection (local Docker copy of veille_db by default)
DATABASE_URL="mysql://root:root@localhost:3306/admin_veille_igts"

# REQUIRED — at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3001
# Comma-separated list of allowed frontend origins
# Comma-separated list of allowed frontend origins (production). In development any local address is accepted.
CORS_ORIGINS=""

# Where the legacy platform serves text PDFs
LEGACY_UPLOADS_URL="https://veille.inter-gts.com/uploads/texte/photos"

# Local LLM (Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ─── Automatic watch of the Official Journal (www.iort.tn) ───
# Every day at 8:30 (Tunis time): new JORT issues are read by the AI (Gemini)
# and saved as drafts; administrators validate them from an e-mail or the platform.
SCRAPER_ENABLED=true
# Gemini reads the PDFs (scanned and Arabic pages included). The JORT is public.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# How many of the latest issues the very first collection reads (the others are skipped)
SCRAPER_FIRST_RUN_ISSUES=1
# Only these administrators receive the e-mails (comma-separated). Empty = all active administrators.
VEILLE_NOTIFY_TO=""
# Drafts and collection history (JSON, outside the shared MySQL database)
VEILLE_DATA_FILE="data/veille.json"
# IORT_URL="https://www.iort.tn/siteiort/"

# Public URL of this API (used to build links to PDFs)
PUBLIC_API_URL="http://localhost:3001/api"
# Where uploaded PDFs are stored
UPLOADS_DIR="uploads"

# ─── Notifications ───
# Public URL of the web app (used in e-mail links)
APP_URL="http://localhost:3000"
# Set to false to disable all e-mails
EMAIL_NOTIFICATIONS=true
MAIL_FROM="IGTS Veille <veille@inter-gts.com>"
# SMTP server. Leave SMTP_HOST empty in development: e-mails are then written
# as .html files in MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_OUTBOX_DIR="outbox"
# Tests on real client data: send EVERY e-mail to this address instead
MAIL_REDIRECT_TO=""
