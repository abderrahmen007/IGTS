# MySQL connection (local Docker copy of veille_db by default)
DATABASE_URL="mysql://root:root@localhost:3306/admin_veille_igts"

# REQUIRED — at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3001
# Comma-separated list of allowed frontend origins
# Comma-separated list of allowed frontend origins (production). In development any local address is accepted.
CORS_ORIGINS=""

# Where the legacy platform serves text PDFs
LEGACY_UPLOADS_URL="https://veille.inter-gts.com/uploads/texte/photos"

# Local LLM (Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Nightly scraper — keep false until the iort.gov.tn connector exists
SCRAPER_ENABLED=false

# Public URL of this API (used to build links to PDFs)
PUBLIC_API_URL="http://localhost:3001/api"
# Where uploaded PDFs are stored
UPLOADS_DIR="uploads"

# ─── Notifications ───
# Public URL of the web app (used in e-mail links)
APP_URL="http://localhost:3000"
# Set to false to disable all e-mails
EMAIL_NOTIFICATIONS=true
MAIL_FROM="IGTS Veille <veille@inter-gts.com>"
# SMTP server. Leave SMTP_HOST empty in development: e-mails are then written
# as .html files in MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_OUTBOX_DIR="outbox"
# Tests on real client data: send EVERY e-mail to this address instead
MAIL_REDIRECT_TO=""
